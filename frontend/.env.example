# Backend API URL (Replace with your deployed backend Vercel URL in production)
# Example: https://certifyai-backend.vercel.app
VITE_API_URL=http://127.0.0.1:8000

# Development sign-in shortcuts. Copy this file to .env.local and fill in real logins.
# .env.local is never committed, and these values are not used in a production build.
VITE_DEV_USER_EMAIL=
VITE_DEV_USER_PASSWORD=
VITE_DEV_ADMIN_EMAIL=
VITE_DEV_ADMIN_PASSWORD=
