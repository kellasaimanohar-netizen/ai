# CertifyAI backend settings. Copy this file to .env and fill in real values. Never commit .env.

# Database (PostgreSQL only). The schema is created and upgraded by `python -m database.migrate`,
# which also runs when the server starts.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=certify Ai
DB_USER=postgres
DB_PASSWORD=
# DATABASE_URL=postgresql://user:password@host:5432/dbname   optional; overrides the DB_* settings

# JWT secret. Must be a long random value (for example: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=

# First administrator. Used only when the users table is empty. Leave blank after the account exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Optional extra logins from the environment. Leave these blank unless you need them: an unset
# password never works as a login. Each password opens only its own account: the one with ADMIN_EMAIL /
# USER_EMAIL (or, without an email, the account the username signs in to). It never opens other accounts.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
USER_USERNAME=
USER_EMAIL=
USER_PASSWORD=

# Report PDFs are saved on this computer, in storage/reports/certify and storage/reports/live (default below).
# REPORTS_DIR=storage/reports

# Forgot password. Links point at FRONTEND_URL (default: the first AA_ALLOWED_ORIGINS entry) and expire after
# PASSWORD_RESET_MINUTES. Without SMTP_HOST nothing is sent; on a developer machine set MAIL_LOG_LINKS=1 to
# print the reset email in the server log instead (never in production: the link opens the account).
# FRONTEND_URL=http://localhost:5173
# PASSWORD_RESET_MINUTES=30
# MAIL_LOG_LINKS=1

# Sign-in. After MAX_FAILED_LOGINS wrong passwords, an account is locked for LOGIN_LOCKOUT_MINUTES.
# MAX_FAILED_LOGINS=10
# LOGIN_LOCKOUT_MINUTES=15

# Days for "today", daily charts and date filters, as an offset from UTC (default India, +05:30)
# APP_UTC_OFFSET=+05:30
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=               for Gmail, an app password (Google Account > Security > App passwords)
# SMTP_FROM=CertifyAI <you@gmail.com>

# Server
AA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
HOST=127.0.0.1

# Repository scans read only folders inside this base folder (default: the folder that holds this project)
# AA_REPO_BASE=C:\Personal
# AA_GIT_CLONE_TIMEOUT=120      seconds before cloning a repository URL gives up

# Outgoing calls. Specs, agents and repositories on this computer or a private network are refused, and TLS
# certificates are checked. For local development only:
# AA_ALLOW_PRIVATE_TARGETS=1    allow localhost and private-network agents (for example an agent on 127.0.0.1)
# AA_INSECURE_TLS=1             accept self-signed certificates

# Live tests
# LIVE_SCHEDULER=1              run scheduled live tests in the background (long-running servers only)
# CRON_SECRET=                  lets an outside cron call /api/user/live/schedules/run-due
# ANTHROPIC_API_KEY=            enables the optional AI judge for live tests

# Tests. Database tests are skipped unless this points at a separate test database.
# TEST_DATABASE_URL=
